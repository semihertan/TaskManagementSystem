<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskManagement.Data</AssemblyName>
    <RootNamespace>TaskManagement.API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TaskManagement.API\Data\ApplicationDbContext.cs"
             Link="Data\ApplicationDbContext.cs" />
    <Compile Include="..\TaskManagement.API\Data\Configurations\*.cs"
             Link="Data\Configurations\%(Filename)%(Extension)" />
    <Compile Include="..\TaskManagement.API\Entities\*.cs"
             Link="Entities\%(Filename)%(Extension)" />
    <Compile Include="..\TaskManagement.API\Enums\*.cs"
             Link="Enums\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
